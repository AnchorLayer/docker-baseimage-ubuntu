              "properties": {
                "purls": [
                  "pkg:deb/ubuntu/libmount1@2.37.2-4ubuntu3.5?arch=amd64\u0026distro=ubuntu-22.04\u0026upstream=util-linux"
                ],
                "security-severity": "4.7"
              }
            },
