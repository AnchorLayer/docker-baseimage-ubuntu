            {
              "id": "CVE-2026-42013-libgnutls30",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-42013 medium vulnerability for libgnutls30 package"
              },
              "fullDescription": {
                "text": "A flaw was found in gnutls. When validating certificates, an oversized Subject Alternative Name (SAN) could cause the validation process to incorrectly fall back to checking the Common Name (CN) field. This could allow a remote attacker to bypass proper certificate validation, potentially leading to spoofing or man-in-the-middle attacks."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-42013",
              "help": {
                "text": "Vulnerability CVE-2026-42013\nSeverity: medium\nPackage: libgnutls30\nVersion: 3.7.3-4ubuntu1.8\nFix Version: 3.7.3-4ubuntu1.9\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: ubuntu:distro:ubuntu:22.04\nLink: [CVE-2026-42013](https://ubuntu.com/security/CVE-2026-42013)",
