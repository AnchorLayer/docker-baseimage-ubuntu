            {
              "id": "CVE-2024-2236-libgcrypt20",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2024-2236 low vulnerability for libgcrypt20 package"
              },
              "fullDescription": {
                "text": "A timing-based side-channel flaw was found in libgcrypt's RSA implementation. This issue may allow a remote attacker to initiate a Bleichenbacher-style attack, which can lead to the decryption of RSA ciphertexts."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2024-2236",
              "help": {
                "text": "Vulnerability CVE-2024-2236\nSeverity: low\nPackage: libgcrypt20\nVersion: 1.9.4-3ubuntu3.2\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: ubuntu:distro:ubuntu:22.04\nLink: [CVE-2024-2236](https://ubuntu.com/security/CVE-2024-2236)",
