            {
              "id": "CVE-2026-5450-libc-bin",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-5450 medium vulnerability for libc-bin package"
              },
              "fullDescription": {
