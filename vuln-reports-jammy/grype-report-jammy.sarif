            {
              "id": "CVE-2026-11856-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-11856 medium vulnerability for curl package"
              },
              "fullDescription": {
                "text": "Successfully using libcurl to do a transfer to a specific HTTP origin\n(`hostA`) with **Digest** authentication and then changing the origin to a\ndifferent one (`hostB`) for a second transfer, reusing the same handle, makes\nlibcurl wrongly pass on the  `Authorization:` header field meant for `hostA`,\nto `hostB`."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-11856",
              "help": {
                "text": "Vulnerability CVE-2026-11856\nSeverity: medium\nPackage: curl\nVersion: 7.81.0-1ubuntu1.25\nFix Version: 7.81.0-1ubuntu1.26\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: ubuntu:distro:ubuntu:22.04\nLink: [CVE-2026-11856](https://ubuntu.com/security/CVE-2026-11856)",
                "markdown": "**Vulnerability CVE-2026-11856**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | curl  | 7.81.0-1ubuntu1.25  | 7.81.0-1ubuntu1.26  | deb  | /var/lib/dpkg/status  | ubuntu:distro:ubuntu:22.04  | [CVE-2026-11856](https://ubuntu.com/security/CVE-2026-11856)  |\n"
              },
              "properties": {
