            {
              "id": "CVE-2026-82208-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-82208 medium vulnerability for curl package"
              },
              "fullDescription": {
                "text": "With the wolfSSL backend, when CA caching is enabled and an\n`CURLOPT_SSL_CTX_FUNCTION` callback replaces the trust store, libcurl can\nsilently reinstall the cached store after the callback returns. A certificate\ntrusted by the cached store but rejected by the callback-selected store is\nthen incorrectly accepted."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-82208",
