              },
              "properties": {
                "purls": [
                  "pkg:deb/ubuntu/libzstd1@1.4.8%2Bdfsg-3build1?arch=amd64\u0026distro=ubuntu-22.04\u0026upstream=libzstd"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "CVE-2026-19931-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-19931 medium vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A flaw in libcurl makes it wrongly reuse an HTTP connection setup for a given\nhostname using Negotiate authentication, when the initial request is done\nusing empty credentials. This can make user B's request get sent over user A's\npreviously authenticated connection."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-19931",
              "help": {
                "text": "Vulnerability CVE-2026-19931\nSeverity: medium\nPackage: curl\nVersion: 7.81.0-1ubuntu1.27\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: ubuntu:distro:ubuntu:22.04\nLink: [CVE-2026-19931](https://ubuntu.com/security/CVE-2026-19931)",
                "markdown": "**Vulnerability CVE-2026-19931**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | curl  | 7.81.0-1ubuntu1.27  |   | deb  | /var/lib/dpkg/status  | ubuntu:distro:ubuntu:22.04  | [CVE-2026-19931](https://ubuntu.com/security/CVE-2026-19931)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/ubuntu/curl@7.81.0-1ubuntu1.27?arch=amd64\u0026distro=ubuntu-22.04"
                ],
                "security-severity": "9.8"
              }
            },
