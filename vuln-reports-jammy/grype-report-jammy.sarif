            {
              "id": "CVE-2026-13608-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-13608 medium vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A flaw in the libcurl SASL negotiation for LDAP authentication allows an\nincomplete handshake sequence to be misinterpreted as a successful\ncryptographic verification. An attacker executing a Man-in-the-Middle (MITM)\nattack can inject a premature or shortcut response that bypasses complete peer\nvalidation."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-13608",
