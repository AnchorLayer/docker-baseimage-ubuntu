            {
              "id": "CVE-2026-80255-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-80255 medium vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A `Set-Cookie:` header using tab (horizontal tab, ASCII code 9) instead of\nspace (ascii code 32) immediately before the `Secure` attribute causes curl to\nstore the cookie without its Secure flag. The cookie might then wrongfully be\nsent over plaintext HTTP on subsequent requests to the same host."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-80255",
