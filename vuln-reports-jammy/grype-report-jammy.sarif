            {
              "id": "CVE-2026-80231-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-80231 medium vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A flaw in libcurl makes it wrongly reuse an existing HTTPS connection setup\nfor a given hostname even when using a different Native CA Store setting\n(`CURLSSLOPT_NATIVE_CA`) than when the connection was created."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-80231",
              "help": {
                "text": "Vulnerability CVE-2026-80231\nSeverity: medium\nPackage: curl\nVersion: 7.81.0-1ubuntu1.27\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: ubuntu:distro:ubuntu:22.04\nLink: [CVE-2026-80231](https://ubuntu.com/security/CVE-2026-80231)",
