            {
              "id": "CVE-2021-3156-sudo",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2021-3156 high vulnerability for sudo package"
              },
              "fullDescription": {
                "text": "Version 1.8.9p5-1ubuntu1.4 is affected with no fixes reported yet."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2021-3156\nSeverity: high\nPackage: sudo\nVersion: 1.8.9p5-1ubuntu1.4\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: ubuntu:distro:ubuntu:14.04\nLink: [CVE-2021-3156](https://ubuntu.com/security/CVE-2021-3156)",
                "markdown": "**Vulnerability CVE-2021-3156**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | sudo  | 1.8.9p5-1ubuntu1.4  |   | deb  | /var/lib/dpkg/status  | ubuntu:distro:ubuntu:14.04  | [CVE-2021-3156](https://ubuntu.com/security/CVE-2021-3156)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/ubuntu/sudo@1.8.9p5-1ubuntu1.4?arch=amd64\u0026distro=ubuntu-14.04"
                ],
