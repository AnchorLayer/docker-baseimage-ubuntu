            {
              "id": "CVE-2026-18508-tar",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-18508 medium vulnerability for tar package"
              },
              "fullDescription": {
                "text": "A flaw was found in GNU tar. When extracting an archive with the --one-top-level option, hardlink targets are not confined to the designated top-level directory and may resolve relative to the extraction working directory. A crafted archive can create hardlinks that escape the intended boundary and, when combined with a preexisting symbolic link under the working directory, may allow writing outside that boundary during a single extraction."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-18508",
              "help": {
                "text": "Vulnerability CVE-2026-18508\nSeverity: medium\nPackage: tar\nVersion: 1.35+dfsg-3ubuntu0.4\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2026-18508](https://ubuntu.com/security/CVE-2026-18508)",
