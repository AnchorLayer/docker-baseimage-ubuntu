              "id": "CVE-2026-6368-libc-bin",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-6368 medium vulnerability for libc-bin package"
              },
              "fullDescription": {
