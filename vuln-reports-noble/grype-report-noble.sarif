            {
              "id": "CVE-2016-20013-libc-bin",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2016-20013 low vulnerability for libc-bin package"
              },
              "fullDescription": {
