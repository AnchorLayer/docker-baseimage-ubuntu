              },
              "properties": {
                "purls": [
                  "pkg:deb/ubuntu/libacl1@2.3.2-1build1.1?arch=amd64\u0026distro=ubuntu-24.04\u0026upstream=acl"
                ],
                "security-severity": "8.4"
              }
            },
            {
              "id": "CVE-2026-18374-libc-bin",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-18374 medium vulnerability for libc-bin package"
              },
              "fullDescription": {
                "text": "Passing an effectively empty string to the `,ccs=` syntax extension of the mode argument in the `fopen` function in the GNU C Library version 2.45 or earlier may result in a heap buffer overflow when the mode string input to the function is attacker controlled.\n\n\n\nThis usage pattern is not seen in applications in common GNU/Linux distributions and applications that process user-supplied values for `ccs` should not pass them through without validation."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-18374",
              "help": {
                "text": "Vulnerability CVE-2026-18374\nSeverity: medium\nPackage: libc-bin\nVersion: 2.39-0ubuntu8.8\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2026-18374](https://ubuntu.com/security/CVE-2026-18374)",
